<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent" tools:targetApi="21">#07515D</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:statusBarColor" tools:targetApi="21">#A5F2F3</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#A5F2F3</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#A5F2F3</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:colorAccent" tools:targetApi="21">#07515D</item>
        <item name="android:textColorPrimary">#102E35</item>
        <item name="android:windowBackground">#213E52</item>
        <item name="android:statusBarColor" tools:targetApi="21">#213E52</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#213E52</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
